APP_NAME=Marine Debris Detection API
APP_VERSION=0.1.0
DEBUG=true
DATABASE_URL=postgresql://marine:marine@localhost:5432/marine_debris
POSTGRES_USER=marine
POSTGRES_PASSWORD=marine
POSTGRES_DB=marine_debris
CORS_ORIGINS=["http://localhost:3000"]
YOLO_MODEL_PATH=../models/marine_debris_yolov8.pt
DETECTION_CONFIDENCE_THRESHOLD=0.25
DETECTION_IOU_THRESHOLD=0.45
# Edge deployment (see `python -m app.ai.export` and `python -m app.ai.benchmark`)
# INFERENCE_BACKEND=torch          # torch | onnx | tensorrt
# YOLO_ONNX_PATH=../models/marine_debris_yolov8.onnx
# YOLO_ENGINE_PATH=../models/marine_debris_yolov8.engine
# INFERENCE_DEVICE=cpu             # cpu or cuda:0 (None = auto)
