# =============================================================================
# SonicSweep — Marine Debris & Anomaly Detection
# Root environment configuration
# =============================================================================
# Copy this file to .env and edit as needed.
#   copy .env.example .env
#
# Backend reads from backend/.env (symlinked or copied from this file).
# Frontend reads NEXT_PUBLIC_API_BASE_URL at build time.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=SonicSweep
APP_VERSION=0.1.0
DEBUG=true

# ---------------------------------------------------------------------------
# Database (PostgreSQL + PostGIS)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://marine:marine@localhost:5432/marine_debris
POSTGRES_USER=marine
POSTGRES_PASSWORD=marine
POSTGRES_DB=marine_debris

# ---------------------------------------------------------------------------
# CORS (comma-separated origins)
# ---------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------------------
# File uploads
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800

# ---------------------------------------------------------------------------
# YOLO model paths (relative to backend/ working directory)
# ---------------------------------------------------------------------------
YOLO_MODEL_PATH=models/best.pt
DETECTION_CONFIDENCE_THRESHOLD=0.25
DETECTION_IOU_THRESHOLD=0.45

# Set to true ONLY for demos when no trained model is available.
# NEVER use in production — placeholder detections are NOT real AI output.
SIMULATION_MODE=false

# ---------------------------------------------------------------------------
# Edge deployment (ONNX / TensorRT)
# Uncomment and configure when you have exported model artifacts.
# ---------------------------------------------------------------------------
INFERENCE_BACKEND=torch
# YOLO_ONNX_PATH=../models/marine_debris_yolov8.onnx
# YOLO_ENGINE_PATH=../models/marine_debris_yolov8.engine
INFERENCE_DEVICE=cpu

# ---------------------------------------------------------------------------
# Frontend (NEXT_PUBLIC_ vars are embedded at build time)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------------------------
# Training pipeline defaults
# Override with CLI flags: python train.py --epochs 50 --device cpu
# ---------------------------------------------------------------------------
# TRAIN_DATA_ROOT=backend/data
# TRAIN_EPOCHS=100
# TRAIN_BATCH=16
# TRAIN_IMGSZ=640
